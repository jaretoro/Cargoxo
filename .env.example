# Copy this file to .env and fill in real values before going live.
# Locally: `docker compose up -d` starts a matching Postgres.

# --- Database ---
# Production (DigitalOcean Managed PostgreSQL) gives you a URL ending in
# ?sslmode=require — use it as-is.
DATABASE_URL="postgresql://cargoxo:cargoxo@localhost:5432/cargoxo"

# --- Auth (NextAuth / Auth.js) ---
# Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe ---
# From https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# From the Stripe CLI (`stripe listen`) or your webhook endpoint settings
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Create these as recurring Prices in the Stripe dashboard (or via `stripe products create`)
STRIPE_PRICE_MONTHLY="price_xxx"
STRIPE_PRICE_YEARLY="price_xxx"

# --- OpenAI (chatbot) ---
OPENAI_API_KEY="sk-xxx"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Approx. NGN per 1 USD, shown on the pricing page as a labeled estimate only —
# Stripe still charges in USD. Update this whenever you want the displayed rate refreshed.
NEXT_PUBLIC_NGN_PER_USD="1600"

# Demo mode: enables the one-click demo login buttons on /login.
# Never set this in a real deployment - it signs in as seeded accounts
# (including admin) without a password.
NEXT_PUBLIC_DEMO_MODE="false"

# Email delivery (password reset). With these unset, mail is written to the
# server log instead of being sent - fine locally, not for production.
# Any SMTP provider works, e.g. SMTP_URL="smtps://user:pass@smtp.example.com:465"
# and EMAIL_FROM="Cargoxo <no-reply@yourdomain.com>".
EMAIL_FROM=""
SMTP_URL=""

# --- Chat rate limiting ---
# Header your host's proxy sets to the real client IP. Without it the per-IP
# chat limit trusts X-Forwarded-For, which clients can fake.
# DigitalOcean App Platform: do-connecting-ip   Vercel: x-real-ip
# Behind Cloudflare: cf-connecting-ip. Leave empty locally.
CLIENT_IP_HEADER=""
# Max chatbot replies per day across all visitors (hard cap on OpenAI spend).
CHAT_DAILY_LIMIT="2000"
